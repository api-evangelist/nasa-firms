    {
      "id": "b92c7159-cebe-4999-9e97-aa940572ccb9",
      "name": "Area Fire Detections",
      "description": {
        "content": "Active fire hotspot detections within a bounding box area",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "986c7271-dfff-4f3e-8985-4bae2eb88e7d",
          "name": "Get area fire detections (most recent)",
          "request": {
            "name": "Get area fire detections (most recent)",
            "description": {
              "content": "Returns active fire detection hotspots within the specified bounding box for the most recent DAY_RANGE days (today back to today minus DAY_RANGE-1). Results are returned in CSV format.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "area",
                "csv",
                ":map_key",
                ":source",
                ":area_coordinates",
                ":day_range"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "map_key",
                  "description": "(Required) Free MAP_KEY obtained via registration at https://firms.modaps.eosdis.nasa.gov/api/map_key/. Rate limited to 5000 transactions per 10-minute interval. Larger requests (e.g., 7-day queries) may count as multiple transactions.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "source",
                  "description": "(Required) Satellite sensor data source."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "area_coordinates",
                  "description": "(Required) Bounding box in west,south,east,north format (decimal degrees), or the string \"world\" for global coverage [-180,-90,180,90].\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "day_range",
                  "description": "(Required) Number of days to include in the query (1 to 5)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/csv"
              }
            ],
            "method": "GET",
            "auth": null
          },
