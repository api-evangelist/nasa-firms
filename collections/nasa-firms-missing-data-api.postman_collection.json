          "request": {
            "name": "Get dates with missing satellite data",
            "description": {
              "content": "Identifies dates for which satellite fire detection data is absent from the FIRMS database, organized by satellite and data type. Near Real-Time entries only appear for dates beyond the final standard processing date for each satellite.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "missing_data",
                ":map_key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "map_key",
                  "description": "(Required) Free MAP_KEY obtained via registration at https://firms.modaps.eosdis.nasa.gov/api/map_key/. Rate limited to 5000 transactions per 10-minute interval. Larger requests (e.g., 7-day queries) may count as multiple transactions.\n"
                }
              ]
            },
