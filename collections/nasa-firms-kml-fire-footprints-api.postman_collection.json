          "name": "Get KML fire footprints by region",
          "request": {
            "name": "Get KML fire footprints by region",
            "description": {
              "content": "Returns a KMZ file containing color-coded fire footprint polygons for a predefined global region and time span. Footprints are color-coded by detection age: 0-6h, 6-12h, 12-24h, and 24h+.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "kml_fire_footprints",
                ":region",
                ":date_span",
                ":sensor",
                ":filename"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "region",
                  "description": "(Required) Predefined geographic region."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "date_span",
                  "description": "(Required) Time span of fire detections to include."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "sensor",
                  "description": "(Required) Satellite sensor source for KML footprints."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "filename",
                  "description": "(Required) KMZ filename in the pattern FirespotArea_{region}_{sensor}_{date_span}.kmz\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.google-earth.kmz"
